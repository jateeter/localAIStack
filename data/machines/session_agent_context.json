{
  "version": "1.0.0",
  "machine": {
    "name": "localai/session_agent_context",
    "description": "Bistable flip-flop pair tracking whether the ReAct agent and its tools have been engaged in this session. Reads raw node-active signals from [7492:7496] and its own prior output (carry feedback) from [7504:7506] to produce a monotonically accumulating carry at [7504:7508]: once agent_ever_engaged or tools_ever_used is set HIGH it remains HIGH for the lifetime of the PE process. Four mutually exclusive sequences cover all combinations of (which node is active) × (which carries are already set).",
    "metadata": {
      "category": "ai-pipeline",
      "author": "localAIStack session context builder",
      "created": "2026-04-17T00:00:00Z",
      "pattern": "bistable-flip-flop",
      "eventSpace": "16D vector at [7492:7508]: [agent_active, _, tools_active, _, topo_out[0:4], rag_carry[0:4], agent_carry, tools_carry, _, _]",
      "outputSpace": "4D carry vector at [7504:7508]: [agent_ever_engaged, tools_ever_used, _, _]",
      "bistableNote": "SET: a sequence fires when a node-active signal is present, writing the correct combined carry to [7504:7508]. HOLD: when no node fires (no agent activity this cycle), no sequence fires and PE carry-forward preserves the output. Carries only increase — there is no CLEAR path, matching the semantic 'ever engaged in this session'.",
      "carryFeedback": "Elements [12:14] of the input region mirror the machine's own output from the prior push cycle (ps[7504:7506]). This allows each sequence to read the existing agent/tools carry state and produce the correct non-regressive combined output.",
      "mutualExclusivity": "Seq 1/2 require element[0] HIGH (agent_active, ps[7492]); Seq 3/4 require element[2] HIGH (tools_active, ps[7494]). Both cannot be HIGH in the same push because push_node_signal sets exactly one node signal at a time. Within each pair, sequences are exclusive on the tools_carry (Seq 1/3) vs agent_carry (Seq 2/4) feedback bit.",
      "sequenceCount": 4,
      "machineClass": "signal-monitor",
      "governance": {
        "schemaVersion": "1.0.0",
        "ownerTeam": "localaistack",
        "runbook": "https://runbooks.example.org/localai/session-agent-context",
        "escalationPolicy": "slack:#localaistack",
        "contact": {
          "primary": "localaistack-primary@example.org",
          "secondary": "localaistack-secondary@example.org"
        },
        "sla": {
          "ok": null,
          "info": null,
          "warning": null,
          "error": null
        },
        "notes": "localAIStack integration machine, registered into the RE at runtime by the reality bridge rather than loaded from the corpus."
      },
      "triggerConfig": {
        "processId": "SESSIONAGENTCONTEXT",
        "processName": "LocalAI Session Agent Context",
        "rules": [
          {
            "sequenceId": "sess-agent-and-prior-tools",
            "outputMatches": [
              1.0,
              1.0,
              0.0,
              0.0
            ],
            "ragStatusCode": "GREEN",
            "processStatus": "info",
            "description": "Fires when the agent node is executing (ps[7492] HIGH) and the tools_used carry is already set (ps[7505] HIGH). Writes [1,1,0,0] — both carries remain HIGH."
          },
          {
            "sequenceId": "sess-agent-first",
            "outputMatches": [
              1.0,
              0.0,
              0.0,
              0.0
            ],
            "ragStatusCode": "GREEN",
            "processStatus": "info",
            "description": "Fires when the agent node is executing (ps[7492] HIGH) and the tools_used carry is not yet set (ps[7505] LOW). Writes [1,0,0,0] — sets agent carry, preserves tools carry at 0."
          },
          {
            "sequenceId": "sess-tools-after-agent",
            "outputMatches": [
              1.0,
              1.0,
              0.0,
              0.0
            ],
            "ragStatusCode": "GREEN",
            "processStatus": "info",
            "description": "Fires when the tools node is executing (ps[7494] HIGH) and the agent_engaged carry is already set (ps[7504] HIGH). Writes [1,1,0,0] — preserves agent carry and sets tools carry."
          },
          {
            "sequenceId": "sess-tools-first",
            "outputMatches": [
              0.0,
              1.0,
              0.0,
              0.0
            ],
            "ragStatusCode": "GREEN",
            "processStatus": "info",
            "description": "Defensive path: fires when tools node is executing but the agent_engaged carry is not yet set (ps[7504] LOW). In normal ReAct flow the agent always runs before tools, so this path handles cold-start or carry-cleared edge cases."
          }
        ]
      }
    },
    "arbiterRule": "PASSTHROUGH",
    "matchAlgorithm": "gte",
    "perceptualMapping": {
      "input": {
        "offset": 7492,
