{
  "version": "1.0.0",
  "machine": {
    "name": "localai/ai_load_bridge",
    "description": "Projects localAI session carry signals into the AI machine input window [272:280], so localAI workflow activity drives the two AI-domain Reality Engine machines that no corpus machine feeds (AIModelWellness [272:276], AIHardwareResilience [276:280]). Reads session_rag/session_agent outputs [112:120] and asserts one of three AI-load patterns (nominal / elevated / critical). Each pattern is an 8-byte composite that matches the PUE escalation tiers defined by AIPowerEfficiency. Narrowed from the original 24-byte projection at [120:144]: the AI machine inputs moved to [256:280], and the first four are now written by corpus machines (AGX051-054), so projecting across all six would contend with deterministic corpus writers on cells no registry declares. See jateeter/localAIStack#48 — this is expected to be revisited when the full localAIStack interconnect is wired in, in the manner of the OpenClaw integration.",
    "metadata": {
      "category": "ai-pipeline",
      "author": "localAIStack ai_load_bridge",
      "created": "2026-04-19T00:00:00Z",
      "pattern": "fan-out-projection",
      "eventSpace": "8D session vector at [112:120]: [last_generate, last_rewrite, last_abort, _, agent_ever_engaged, tools_ever_used, _, _]",
      "outputSpace": "8D composite at [272:280]: 2 x 4-byte AI input patterns (ModelWellness, HardwareResilience)",
      "tags": [
        "ai-pipeline",
        "localai",
        "bridge",
        "ai-load"
      ],
      "routingLogic": {
        "nominal": "last_generate HIGH  → write efficient-tier vector [0.15,0.3,0.2,0.1] × 6",
        "elevated": "last_rewrite HIGH   → write elevated-tier vector [0.62,0.65,0.58,0.6] × 6",
        "critical": "last_abort HIGH     → write critical-tier vector [0.92,0.95,0.88,0.91] × 6",
        "mutualExclusivity": "session_rag upstream asserts exactly one of last_generate/last_rewrite/last_abort per RAG cycle (rag_corrective_cycle mutexes them), so at most one sequence fires per push"
      },
      "sequenceCount": 3,
      "machineClass": "bridge",
      "governance": {
        "schemaVersion": "1.0.0",
        "ownerTeam": "localaistack",
        "runbook": "https://runbooks.example.org/localai/ai-load-bridge",
        "escalationPolicy": "slack:#localaistack",
        "contact": {
          "primary": "localaistack-primary@example.org",
          "secondary": "localaistack-secondary@example.org"
        },
        "sla": {
          "ok": null,
          "info": null,
          "warning": null,
          "error": null
        },
        "notes": "localAIStack integration machine, registered into the RE at runtime by the reality bridge rather than loaded from the corpus."
      },
      "triggerConfig": {
        "processId": "AILOADBRIDGE",
        "processName": "LocalAI Load Bridge",
        "rules": [
          {
            "sequenceId": "ailb-generate-nominal",
            "outputMatches": [
              0.15,
              0.3,
              0.2,
              0.1,
              0.15,
              0.3,
              0.2,
              0.1
            ],
            "ragStatusCode": "GREEN",
            "processStatus": "info",
            "description": "Fires when session_rag.last_generate is HIGH (ps[112] >= 0.5). Writes the PUE-efficient tier pattern across the two unclaimed AI machine inputs [272:280] so AIPowerEfficiency, AICoolingRegulator, etc. produce their OPTIMAL / INFO outputs."
          },
          {
            "sequenceId": "ailb-rewrite-elevated",
            "outputMatches": [
              0.62,
              0.65,
              0.58,
              0.6,
              0.62,
              0.65,
              0.58,
              0.6
            ],
            "ragStatusCode": "GREEN",
            "processStatus": "info",
            "description": "Fires when session_rag.last_rewrite is HIGH (ps[113] >= 0.5). Rewrites indicate the retrieval pipeline is working harder (extra query reformulation) — project the PUE-elevated tier pattern so AIPowerEfficiency/AICoolingRegulator respond with WARNING outputs."
          },
          {
            "sequenceId": "ailb-abort-critical",
            "outputMatches": [
              0.92,
              0.95,
              0.88,
              0.91,
              0.92,
              0.95,
              0.88,
              0.91
            ],
            "ragStatusCode": "GREEN",
            "processStatus": "info",
            "description": "Fires when session_rag.last_abort is HIGH (ps[114] >= 0.5). Abort means the RAG pipeline exhausted its rewrite budget — surface as AI-domain CRITICAL load so AISecurityMonitor / AIHardwareResilience and the PUE-critical tier outputs fire."
          }
        ]
      }
    },
