# LangGraph / LangChain
.langgraph_api/

# Environment
.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
# pytest writes its own .gitignore inside this dir, so it is normally
# self-ignoring — listed explicitly so the protection does not depend on that.
.pytest_cache/

# macOS
.DS_Store

# Stack volumes and local data
volumes/
data/documents/*
!data/documents/.gitkeep
/tmp/

# Downloaded GGUF weights — fetched by scripts/setup.sh from HuggingFace
models/*/gguf/
